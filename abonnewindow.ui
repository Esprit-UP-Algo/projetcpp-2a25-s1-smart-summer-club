<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AbonneWindow</class>
 <widget class="QMainWindow" name="AbonneWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Gestion des Abonnés</string>
  </property>

  <!-- STYLE GLOBAL: bleu ciel / orange / noir -->
  <property name="styleSheet">
   <string notr="true">
    QMainWindow {
        background-color: #E3F2FD;      /* bleu ciel très clair */
    }

    QLabel#labelTitle {
        color: #0D47A1;                 /* bleu plus foncé pour le titre */
        font-size: 26px;
        font-weight: bold;
    }

    QLabel {
        color: #0D47A1;
        font-weight: 500;
    }

    /* Champs de saisie */
    QLineEdit {
        background-color: #FFFFFF;
        color: #000000;
        border: 1px solid #90CAF9;      /* bleu ciel */
        border-radius: 6px;
        padding: 4px 8px;
    }
    QLineEdit:focus {
        border: 1px solid #FF8C32;      /* orange */
    }

    QDateEdit {
        background-color: #FFFFFF;
        color: #000000;
        border: 1px solid #90CAF9;
        border-radius: 6px;
        padding: 2px 6px;
    }
    QDateEdit::down-arrow {
        image: none;
    }

    /* Table d'affichage */
    QTableView#tableWidget {
        background-color: #FFFFFF;
        color: #000000;
        gridline-color: #90CAF9;
        selection-background-color: #FFB74D;   /* orange clair sélection */
        selection-color: #000000;
        border: 1px solid #90CAF9;
        alternate-background-color: #E3F2FD;
    }

    /* En-têtes de la table */
    QHeaderView::section {
        background-color: #BBDEFB;
        color: #0D47A1;
        padding: 4px;
        border: none;
        border-right: 1px solid #90CAF9;
    }

    /* Boutons – tous orange, même supprimer + trier + exportation */
    QPushButton {
        background-color: #FF8C32;      /* orange */
        color: #000000;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: bold;
    }
    QPushButton:hover {
        background-color: #FFA857;
    }
    QPushButton:pressed {
        background-color: #CC6F25;
    }

    /* Ligne de recherche */
    QLineEdit#lineEdit_search {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding-left: 10px;
    }

    /* GroupBox infos abonné */
    QGroupBox {
        color: #0D47A1;
        border: 1px solid #90CAF9;
        border-radius: 8px;
        margin-top: 8px;
        background-color: #EAF4FF;
    }
    QGroupBox::title {
        subcontrol-origin: margin;
        left: 10px;
        padding: 0 4px;
    }
   </string>
  </property>

  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout">
    <!-- Title -->
    <item>
     <widget class="QLabel" name="labelTitle">
      <property name="text">
       <string>Gestion des Abonnés</string>
      </property>
      <property name="alignment">
       <set>Qt::AlignHCenter|Qt::AlignVCenter</set>
      </property>
     </widget>
    </item>

    <!-- Search Field + Button -->
    <item>
     <layout class="QHBoxLayout">
      <property name="spacing">
       <number>10</number>
      </property>
      <item>
       <widget class="QLineEdit" name="lineEdit_search">
        <property name="minimumHeight">
         <number>32</number>
        </property>
        <property name="placeholderText">
         <string>Entrez l'ID pour rechercher ou supprimer</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="pushButton_search">
        <property name="minimumHeight">
         <number>32</number>
        </property>
        <property name="text">
         <string>Rechercher</string>
        </property>
       </widget>
      </item>
     </layout>
    </item>

    <!-- Table -->
