      </property>
      <property name="selectionMode">
       <enum>QAbstractItemView::SingleSelection</enum>
      </property>
     </widget>
    </item>

    <!-- Group des champs (Input Fields) avec labels -->
    <item>
     <widget class="QGroupBox">
      <property name="title">
