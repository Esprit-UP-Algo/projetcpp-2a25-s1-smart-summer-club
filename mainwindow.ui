     <widget class="QGroupBox" name="groupBox_table">
      <property name="geometry">
       <rect>
        <x>0</x>
        <y>-21</y>
        <width>1241</width>
        <height>661</height>
       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">
QGroupBox {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #0d47a1,   /* bleu profond */
        stop:1 #00acc1    /* cyan doux */
    );
    border: 1.5px solid #0b3c91;
    border-radius: 10px;
    margin-top: 22px;

    color: #e3f2fd;
    font-weight: 600;
    font-size: 14px;

    padding: 10px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;  /* changement : titre aligné à gauche */
    padding: 3px 12px;

    background: transparent;        /* différent de la page ajout */
    color: #ffffff;
    border: none;
    border-bottom: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 0;
}</string>
