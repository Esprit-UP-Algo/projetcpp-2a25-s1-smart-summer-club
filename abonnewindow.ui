       <!-- Email -->
       <item row="4" column="0">
        <widget class="QLabel" name="label_mail">
         <property name="text">
          <string>Email :</string>
         </property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="QLineEdit" name="lineEdit_mail">
