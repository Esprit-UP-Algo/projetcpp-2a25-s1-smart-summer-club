       <!-- Téléphone -->
       <item row="3" column="0">
        <widget class="QLabel" name="label_tel">
         <property name="text">
          <string>Téléphone :</string>
         </property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="QLineEdit" name="lineEdit_tel">
         <property name="placeholderText">
          <string>Téléphone</string>
