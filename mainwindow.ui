      <property name="styleSheet">
       <string notr="true">QGroupBox {
    background: qlineargradient(
        spread:pad, 
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #4facfe,
        stop:1 #00f2fe
    );
    border: 1.8px solid #1a73e8;
    border-radius: 10px;
    margin-top: 25px;
    
    color: white;
    font-weight: bold;
    font-size: 15px;

    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;

    padding: 4px 12px;
    border-radius: 8px;

    background: qlineargradient(
        spread:pad, 
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #2196f3,
        stop:1 #21cbf3
    );
    color: white;

    border: 1px solid rgba(255,255,255,0.4);
}

/* Icône dans le titre (depuis Imgur) */
QGroupBox::title {
    padding-left: 26px;
    background-image: url(&quot;https://i.imgur.com/4AiXzf8.png&quot;);
    background-repeat: no-repeat;
    background-position: 6px center;
}</string>
