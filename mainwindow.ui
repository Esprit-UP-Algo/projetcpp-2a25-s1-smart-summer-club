       <property name="styleSheet">
        <string notr="true">QPushButton {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #1e88e5,
        stop:1 #26c6da
    );
    color: white;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    padding: 6px 14px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #42a5f5,
        stop:1 #4dd0e1
    );
    border: 1px solid #ffffff;
}

QPushButton:pressed {
    background: qlineargradient(
        spread:pad,
        x1:1, y1:1, x2:0, y2:0,
        stop:0 #1565c0,
        stop:1 #00838f
    );
    padding-top: 7px;
    padding-bottom: 5px;
}

QPushButton:disabled {
    background: #90a4ae;
    color: #eceff1;
    border: 1px solid #b0bec5;
}</string>
