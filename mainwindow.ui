      <widget class="QPushButton" name="pushButton_generateQR">
       <property name="geometry">
        <rect>
         <x>660</x>
         <y>380</y>
         <width>380</width>
         <height>40</height>
        </rect>
       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton {
    /* Style de base */
    background-color: #3498db;  /* Couleur de fond bleu */
    color: #ffffff;  /* Couleur du texte blanc */
    border-radius: 15px;  /* Bords arrondis avec un rayon de 15px */
    padding: 10px 20px;  /* Marges intérieures */
    font-family: 'Arial', sans-serif;  /* Police Arial */
    font-size: 16px;  /* Taille de la police */
    border: 2px solid #2980b9;  /* Bordure avec une couleur légèrement plus foncée */
    transition: all 0.3s ease;  /* Effet de transition lisse */
}

QPushButton:hover {
    /* Effet lors du survol */
    background-color: #2980b9;  /* Couleur de fond légèrement plus foncée */
    border: 2px solid #1f618d;  /* Couleur de la bordure encore plus foncée */
}

QPushButton:pressed {
    /* Effet lors du clic */
    background-color: #1f618d;  /* Couleur de fond encore plus foncée */
    border: 2px solid #154360;  /* Bordure très foncée */
    color: #ecf0f1;  /* Légère variation de la couleur du texte */
}

QPushButton:disabled {
    /* Style du bouton désactivé */
    background-color: #bdc3c7;  /* Couleur de fond gris clair */
    color: #7f8c8d;  /* Couleur du texte gris foncé */
    border: 2px solid #95a5a6;  /* Bordure gris foncé */
}

QPushButton {
    /* Ombre portée */
    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);  /* Légère ombre portée */
}
</string>
       </property>
