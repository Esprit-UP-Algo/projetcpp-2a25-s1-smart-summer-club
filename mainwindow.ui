    <property name="styleSheet">
     <string notr="true">QTabWidget::pane {
    border: 1px solid #3949ab;
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #283593,
        stop:1 #7b1fa2
    );
    border-radius: 8px;
    padding: 6px;
}

QTabBar::tab {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #3949ab,
        stop:1 #5e35b1
    );
    color: #e8eaf6;
    padding: 8px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
    font-weight: 600;
    min-width: 90px;
}

QTabBar::tab:selected {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5e35b1,
        stop:1 #7e57c2
    );
    color: white;
}

QTabBar::tab:hover {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #536dfe,
        stop:1 #7c4dff
    );
    color: white;
}

QTabBar::tab:!selected {
    margin-top: 4px;
}</string>
