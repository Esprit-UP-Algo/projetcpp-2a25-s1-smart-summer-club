       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton {
	color: rgb(0, 170, 0);
    /* Style de base */
    background-color: #e74c3c;  /* Rouge vif pour attirer l'attention */
    color: #ffffff;  /* Texte blanc */
    border-radius: 25px;  /* Bords arrondis */
    padding: 10px 25px;  /* Marges intérieures */
    font-family: 'Helvetica', sans-serif;  /* Police Helvetica */
    font-size: 18px;  /* Taille de la police */
    border: none;  /* Pas de bordure */
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);  /* Ombre portée légère */
    transition: background-color 0.3s ease, transform 0.2s ease;  /* Transitions pour les effets */
    min-width: 150px;  /* Largeur minimale pour uniformité */
    min-height: 50px;  /* Hauteur minimale */
}

QPushButton:hover {
    /* Effet lors du survol */
    background-color: #c0392b;  /* Rouge légèrement plus foncé */
    transform: translateY(-2px);  /* Légère translation vers le haut pour effet d'élévation */
}

QPushButton:pressed {
    /* Effet lors du clic */
    background-color: #a93226;  /* Rouge encore plus foncé */
    box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.3);  /* Ombre portée réduite pour effet d'enfoncement */
    transform: translateY(0);  /* Retour à la position normale */
}

QPushButton:disabled {
    /* Style du bouton désactivé */
    background-color: #e0e0e0;  /* Gris clair */
    color: #7f8c8d;  /* Texte gris foncé */
    box-shadow: none;  /* Pas d'ombre */
    cursor: not-allowed;  /* Curseur non autorisé */
}
</string>
       </property>
